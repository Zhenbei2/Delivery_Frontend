<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC</title>
    @*    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />*@

    <link rel="stylesheet" href="/bootstrap/css/bootstrap.css" />
    <script src="/js/jquery.js"></script>
    <script src="/js/load.js"></script>

</head>
<body>
    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">Delivery.Eats</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/Home/index" target="_parent">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/orders" target="_parent">Order</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/cart" target="_parent">Carts<span class="badge text-bg-success" id='carts_len' style="margin-left: 5px;">4</span></a>
                        </li>
                    </ul>
                    <div class="d-flex" role="search">
                        <div id="login_register_div">
                            <label class="form-label" style="margin-top: 8px;margin-right: 10px;">please login first</label>
                            <a class="btn btn-outline-success" href="/Home/login" target="_parent">login</a>
                            <a class="btn btn-outline-success" href='/Home/register' target="_parent">register</a>
                        </div>
                        <div id="username_logout_div" style="display: none;">
                            <label class="form-label" style="margin-top: 8px; margin-right: 10px;">Welcome <label id="nav_username" style="font-weight: bold;"></label></label>
                            <a class="btn btn-outline-success" href="/Home/profile" target="_parent">profile</a>
                            <button class="btn btn-outline-success" onclick="logout()">Logout</button>
                        </div>
                    </div>
                </div>


            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    @*    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>*@
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
            init_user();
        });

    </script>
</body>
</html>
