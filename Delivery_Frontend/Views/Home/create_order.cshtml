
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8" />
		<title></title>
		<link rel="stylesheet" href="/bootstrap/css/bootstrap.css" />
		<link rel="stylesheet" href="/bootstrap-icons-1.10.4/font/bootstrap-icons.css" />
		<link rel="stylesheet" href="/css/style.css" />
		<script src="/js/jquery.js"></script>
			<script src="/js/create_order.js"></script>
	</head>
	<body>
@*		<div id="header">
			<iframe align="center" width="100%" height="80" src="/nav" frameborder="no" border="0" marginwidth="0"
				marginheight="0" scrolling="no"></iframe>
		</div>*@

		<div class="container shadow">
			<h2>Create Order</h2>
			<div class="card">
				<div class="card-body">
					<form  action="" onsubmit="return create_order()">
						<h2>User Data</h2>
						<div class="row">
							<div class="col">
								<label for="inputEmail4">Phone Number</label>
								<input type="text" class="form-control" id="phoneNumber" disabled>
							</div>
							<div class="col">
								<label for="inputPassword4">Email</label>
								<input type="email" class="form-control" id="email" disabled>
							</div>
						</div>
						<h2>Deliver data</h2>
						<div class="row">
							<div class="col">
								<label for="inputEmail4">Deliver address</label>
								<input type="text" class="form-control" id="address" required>
							</div>
							<div class="col">
								<label for="inputPassword4">Deliver time</label>
								<input type="datetime-local" id="deliveryTime" class="form-control" required>
							</div>
						</div>
						<button type="submit" class="btn btn-primary" style="display: none;"  id="createOrder"></button>
				
					</form>
				</div>
				<div class="card-body">

					<p class="card-text" style="padding-top: 15px;">Item list</span></p>
					<div class="border" id='dishes'>
						<div class="border-bottom cart_food">

							<img class="rounded cart-image"
								src="https://mistertako.ru/uploads/products/9ee8ed49-8327-11ec-8575-0050569dbef0.">
							<div class="cart_item_div">
								<div style="margin-top: 10px;font-weight: bold;">Cheesecake New York</div>
								<div style="margin-top: 10px;">Price:250 $/dish</div>
								<div style="margin-top: 4px;">Quantity:1</div>
							</div>

							<div class="remove">
								<div>Price:250$</div>
							</div>

						</div>
					</div>
					<p class="card-text" style="padding-top: 15px;"><b>Total</b> <label id="total">250</label>$</span></p>
					<button type="button" class="btn btn-success" onclick="confirm_order()">Confirm order</button>
				</div>
			</div>
		</div>

	</body>
	<script>
		$(function() {
			init()
		});
	</script>
</html>