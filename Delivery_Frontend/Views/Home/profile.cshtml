@{
	//Layout = null;
}
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8" />
		<title></title>
		<link rel="stylesheet" href="/bootstrap/css/bootstrap.css" />
		<link rel="stylesheet" href="/css/style.css" />
		<script src="/js/jquery.js"></script>
		<script src="/js/profile.js"></script>
	</head>
	<body onload="init()">
@*		<div id="header">
			<iframe align="center" width="100%" height="80" src="/nav" frameborder="no" border="0" marginwidth="0"
				marginheight="0" scrolling="no"></iframe>
		</div>*@
		<div class="container shadow">
			<h2>Profile</h2>
			<form action="" onsubmit="return updateProfile()" id="profile">
				<div class="row mb-3">
					<label for="name" class="col-sm-2 col-form-label">Name:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="fullName" name='fullName' value="Jobn jj" required>
					</div>
				</div>
				<div class="row mb-3">
					<label for="email" class="col-sm-2 col-form-label">Email:</label>
					<div class="col-sm-10">
						<input type="text" readonly class="form-control-plaintext" id="email" name="email" value="email@example.com">
					</div>
				</div>
				<div class="row mb-3">
					<label for="name" class="col-sm-2 col-form-label">Date of birth:</label>
					<div class="col-sm-10">
						<input type="date" class="form-control" id="birthDate" name="birthDate" placeholder="+7 (xxx) xxx-xx-xx-xx" required>
					</div>
				</div>
				<div class="row mb-3">
					<label for="gender" class="col-sm-2 col-form-label">Gender:</label>
					<div class="col-sm-10">
						<input type="text" readonly class="form-control-plaintext" id="gender" name="gender" value="Male" required>
					</div>
				</div>
				<div class="row mb-3">
					<label for="address" class="col-sm-2 col-form-label">Home Adress:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="address" name="address" value="Jobn jj" required>
					</div>
				</div>
				<div class="row mb-3">
					<label for="address" class="col-sm-2 col-form-label">Phone Number:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="phoneNumber" name='phoneNumber' required placeholder="+7 (xxx) xxx-xx-xx-xx" pattern="^[+]{1}7\s[(]{1}[0-9]{3}[)]{1}\s[0-9]{3}-[0-9]{2}-[0-9]{2}$">
					</div>
				</div>
				<div class="form-group" style="margin-top: 10px;">
					<button type="submit" class="btn btn-primary">Save Change</button>
				</div>

			</form>
		</div>

	</body>
</html>